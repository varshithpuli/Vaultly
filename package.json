{
  "name": "vaultly",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && mkdir -p www && cp -r dist/* www/ && npx cap copy android 2>/dev/null || true",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "sync": "npx cap sync android"
  },
